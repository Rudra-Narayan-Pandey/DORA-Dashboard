# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Azure DevOps REST API Configuration
AZURE_PAT=your_azure_personal_access_token_here
AZURE_ORGANIZATION=your_azure_organization_name_here
AZURE_PROJECT=your_azure_project_name_here
AZURE_API_VERSION=7.1

# Incident Configuration
# Set the work item type to look for when fetching outages/incidents (e.g. Bug, Issue, Incident)
AZURE_INCIDENT_WORK_ITEM_TYPE=Bug

# Security & CORS
# Lock down CORS to the address of the React frontend in production
FRONTEND_URL=http://localhost:5173
